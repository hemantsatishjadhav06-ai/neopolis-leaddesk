# ---- Neopolis LeadDesk — environment variables (secrets live ONLY here, never in code) ----

# App
PORT=8080
PUBLIC_URL=https://your-app.up.railway.app     # used for webhook URL + links in alerts/sheet
DATA_DIR=/data                                  # SQLite lives here (Railway: mount a volume at /data)
TRUST_PROXY=true

# First admin (optional — otherwise the first visit shows a setup screen)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Meta WhatsApp Cloud API (official)
WHATSAPP_TOKEN=                # permanent System User token (whatsapp_business_messaging + whatsapp_business_management)
PHONE_NUMBER_ID=               # the sender's phone_number_id (e.g. for +91 9876543210)
WABA_ID=YOUR_WABA_ID       # WhatsApp Business Account id
META_APP_ID=YOUR_META_APP_ID   # Meta app id ("Neopolis Infra Messaging")
META_APP_SECRET=               # app secret → validates webhook signatures + auto-configures the webhook
VERIFY_TOKEN=neopolis-leaddesk-verify
GRAPH_VERSION=v21.0
WA_MOCK=0                      # 1 = no real WhatsApp calls (local testing)

# AI (OpenRouter by default)
AI_PROVIDER=openrouter         # openrouter | openai | mock
OPENROUTER_API_KEY=
AI_MOCK=0

# Brain: 'n8n' = the n8n workflows reply + run the journey and post events to /api/ingest (LeadDesk = inbox);
#        'leaddesk' = this app replies and runs the journey itself.
BRAIN=n8n
INGEST_SECRET=                 # shared secret n8n sends in the X-Ingest-Secret header

# Google Sheet (choose ONE connector)
#  0) n8n Sheet Bridge (uses n8n's Google Sheets credential — zero Google setup)
N8N_BRIDGE_URL=                # the bridge workflow's webhook URL
N8N_BRIDGE_SECRET=             # X-Bridge-Secret header value
SPREADSHEET_ID=YOUR_SHEET_ID_HERE
LEADS_TAB=                     # blank = auto-detect the tab with whatsapp_number + lead_status headers
REPLIES_TAB=Client Replies
#  a) Apps Script connector (recommended, no Google Cloud project needed)
SHEETS_APPS_SCRIPT_URL=        # the /exec URL from Deploy → Web app
SHEETS_APPS_SCRIPT_SECRET=     # same value as SECRET inside Code.gs
#  b) or a service account (base64 of the JSON key; share the sheet with its client_email)
GOOGLE_SERVICE_ACCOUNT_B64=
# SHEETS_PROVIDER=appsscript   # auto-chosen from the variables above; 'memory' = fake sheet for tests

# Optional alerts (POSTed as JSON when the AI hands a lead to sales / a human-mode chat gets a reply)
ALERT_WEBHOOK_URL=

# Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=60
